# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing credentials & keystore (never commit!)
android/key.properties
android/app/upload-keystore.jks

# ============================================================
# ADDITIONS — sensitive data, tests, build artifacts, large files
# ============================================================

# Android build outputs (nested .gitignore covers /.gradle but not /build/)
/android/build/

# Android heap dumps / profiling snapshots (can be hundreds of MB)
*.hprof

# Test files — no test files in the public repo
/test/

# Research / reference images (not part of the shipped app)
/.research/

# Backup files
*.bak

# Local test-only symlink to isar_flutter_libs native lib (recreated on demand)
/libisar.so
